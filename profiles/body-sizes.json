  "warmup": "5s",
  "window": "15s",
  "repetitions": 3,
  "rates": [10],
  "requestBodySizesBytes": [16384, 65536, 262144],
  "pollInterval": "5s",
  "freshnessLimit": "30s",
  "percentileMinimumSamples": 100,
  "signalRate": 10,
  "directReferenceRate": 10,
  "pressureTargetPool": "pool-a",
  "slo": null
}
