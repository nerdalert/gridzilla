{
  "version": 1,
  "name": "body-sizes",
  "description": "Generic endpoint request-size sweep at 16, 64, and 256 KiB, with three independent measurement windows per size.",
  "maxArrivalRatePerSecond": 25,
  "preallocatedVUs": 10,
  "maxVUs": 20,
  "maxConcurrency": 20,
  "requestTimeout": "20s",
